# Extends the Query of the example schema that every suite serves; the names below must not clash with it.
extend type Query {
  # sets a cookie and a header on the HTTP response
  haSetCookie: Boolean!
  # the value of the request header X-Tck; over WebSocket the header of the upgrade request
  haRequestHeader: String
  # asks for the plain response: over WebSocket the field fails
  haResponse: Boolean
  # whether the response is present: true over HTTP, false over WebSocket
  haOptionalResponse: Boolean!
}
extend type Query {
  # the path of the request: /graphql over HTTP, the path of the upgrade request over WebSocket
  haRequestPath: String
  # the identity of the request object, to tell whether two operations share it
  haRequestIdentity: Int!
  # the name of the principal, "none" when the parameter is null
  haPrincipal: String!
}

extend type Mutation {
  haMutationRequestHeader: String
  haMutationOptionalResponse: Boolean!
  haMutationResponse: Boolean
}

# The example schema has a schema definition, which does not name a subscription type.
extend schema {
  subscription: Subscription
}

type Subscription {
  haSubscriptionRequestHeader: String
  haSubscriptionOptionalResponse: Boolean!
  haSubscriptionResponse: Boolean
}
