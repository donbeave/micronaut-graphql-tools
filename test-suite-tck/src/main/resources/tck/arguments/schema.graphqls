# Extends the Query (and Mutation) of the example schema that every suite serves; the types below must not clash with its names.
enum Color {
  RED
  GREEN
  BLUE
}

input Point {
  x: Int!
  y: Int!
}

input Shape {
  name: String!
  color: Color = GREEN
  points: [Point!]!
  note: String
}

input Stock {
  sku: String!
  quantity: Int!
  weight: Float
  tags: [String!]
  colors: [Color!]
  comment: String
}

input Dimensions {
  width: Int!
  unit: String
}

input Part {
  name: String!
  note: String
}

input Crate {
  label: String!
  dimensions: Dimensions!
  parts: [Part!]!
  memo: String
}

extend type Query {
  scalars(text: String!, number: Int!, ratio: Float!, flag: Boolean!, id: ID!): String!

  defaults(text: String = "fallback", count: Int = 3, color: Color = BLUE): String!

  presence(text: String): String!

  total(numbers: [Int!]!): Int!

  grid(rows: [[Int!]!]!): Int!

  shape(shape: Shape!): String!

  stock(stock: Stock!): String!

  crate(crate: Crate!): String!

  window(first: Int!, offset: Int!, in: String!): String!
}

extend type Mutation {
  add(amount: Int!): Int!
}
