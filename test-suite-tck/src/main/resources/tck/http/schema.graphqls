# Extends the Query of the example schema that every suite serves; the names below must not clash with it.
extend type Query {
  httpEcho(value: String!): String!
  # the header X-Tenant of the request, which a context contributor puts in the GraphQL context
  tenant: String
  # the tenant, loaded through a batch loader of the execution
  tenantLoaded: String
  # an id of the data loader of the execution: it differs between executions
  loaderId: String!
}
