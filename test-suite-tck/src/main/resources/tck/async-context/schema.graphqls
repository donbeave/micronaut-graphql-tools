# Extends the Query of the example schema that every suite serves; the names below must not clash with it.
extend type Query {
  asyncOtherPool: AsyncParent!
  asyncNonBlocking: AsyncParent!
  asyncMono: AsyncParent!
  asyncDone: AsyncParent!
}

# The fields of the child say what the request context looks like where the child is resolved.
type AsyncParent {
  contextElement: String
  loggingEntry: String
  onEventLoop: Boolean!
}
