# Extends the Query of the example schema that every suite serves; the names below must not clash with it.
extend type Query {
  derivedResults: [DerivedResult!]!
}

union DerivedResult = DerivedBook | DerivedMagazine | DerivedPoster

type DerivedBook {
  title: String!
}

type DerivedMagazine {
  issue: Int!
}

type DerivedPoster {
  caption: String!
}
