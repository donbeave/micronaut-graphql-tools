# Extends the Query of the example schema that every suite serves; the names below must not clash with it.
extend type Query {
  decoratedEcho(text: String!): String!
  decoratedAsync(text: String!): String!
  undecoratedPlain: String!
  decoratedBox: DecoratedBox!
}

# A property fetcher is trivial: no decorator selects it.
type DecoratedBox {
  label: String!
}
