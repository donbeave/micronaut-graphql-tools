# Extends the Query of the example schema that every suite serves; the names below must not clash with it.
extend type Query {
  onThreadPlain: String!
  onThreadSame: String!
  onThreadOther: String!
  onThreadAsync: String!
  executeOnBox: ExecuteOnBox!
  executeOnCrate: ExecuteOnCrate!
  requestTasks: Int!
  otherTasks: Int!
}

# A property reads on the thread that resolves the parent and never hops.
type ExecuteOnBox {
  property: String!
  modelMethod: String!
  typeResolver: String!
}

# The model class carries @ExecuteOn, which applies to its bound methods.
type ExecuteOnCrate {
  property: String!
  crated: String!
}
