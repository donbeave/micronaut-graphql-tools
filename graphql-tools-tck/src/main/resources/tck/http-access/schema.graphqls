# Extends the Query of the example schema that every suite serves; the names below must not clash with it.
extend type Query {
  # sets a cookie and a header on the HTTP response
  haSetCookie: Boolean!
  # the value of the request header X-Tck; over WebSocket the header of the upgrade request
  haRequestHeader: String
  # asks for the plain response: over WebSocket the field fails
  haResponse: Boolean
  # whether the response is present: true over HTTP, false over WebSocket
  haOptionalResponse: Boolean!
}
