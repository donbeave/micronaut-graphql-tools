# Extends the Query of the example schema that every suite serves; the names below must not clash with it.
extend type Query {
  paramContext: String!
  paramContextValue: String!
  paramMissingValue: String
  paramEnvironment: String!
  paramSelection: ParamBook!
  paramLocale: Boolean!
  paramRequest: String!
  paramResponse: Boolean!
  paramOptionalResponse: Boolean!
  paramPrincipal: String!
  paramMixed(name: String!, count: Int!): String!
}

type ParamBook {
  title: String!
  author: String!
}
