# Extends the Query of the example schema that every suite serves; the names below must not clash with it.
extend type Query {
  # completes after a delay, on a thread that is not an event loop thread
  slowParent: SlowParent!
  # how many slowParent fields were started
  slowStarts: Int!
  # how many fields of the slow parent ran, which a cancelled execution must not start
  childRuns: Int!
}

type SlowParent {
  child: String!
}
