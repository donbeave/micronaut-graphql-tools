type Query {
  book(id: ID!): Book
  books(genre: String): [Book!]!
  search(term: String!): [SearchResult!]!
  version: String
}

type Mutation {
  save(title: String!): Book
}

type Subscription {
  bookAdded: Book
}

type Book {
  id: ID!
  title: String
  author: String
}

type Magazine {
  id: ID!
  issue: Int
}

union SearchResult = Book | Magazine
