# gradle-profiler scenarios of the compile-time checks (#418). One project per language and tool, each with six scenarios:
# a clean build, a body-only edit and a schema edit (both made by an init script task inside the measured build), with the checks on and with the checks off (the control).
# Scenario names are <sample>-<edit>-<on|off>. `run.sh` (and the Gradle task compileTimeProfile) runs them against copies of
# the samples; the control is -PgraphqlChecks=false, which keeps the processor on the compile path and turns its checks off.

common = ["-I", "profiler.init.gradle"]
on = ["-PgraphqlChecks=true"]
off = ["-PgraphqlChecks=false"]

java-gradle-clean-on {
  tasks = ["classes"]
  cleanup-tasks = ["clean"]
  gradle-args = ${common} ${on} ["-PprofilerScenario=java-gradle-clean-on"]
}
java-gradle-body-on {
  tasks = [":editBody", "classes"]
  gradle-args = ${common} ${on} ["-PprofilerScenario=java-gradle-body-on"]
}
java-gradle-schema-on {
  tasks = [":editSchema", "classes"]
  gradle-args = ${common} ${on} ["-PprofilerScenario=java-gradle-schema-on"]
}

java-gradle-clean-off {
  tasks = ["classes"]
  cleanup-tasks = ["clean"]
  gradle-args = ${common} ${off} ["-PprofilerScenario=java-gradle-clean-off"]
}
java-gradle-body-off {
  tasks = [":editBody", "classes"]
  gradle-args = ${common} ${off} ["-PprofilerScenario=java-gradle-body-off"]
}
java-gradle-schema-off {
  tasks = [":editSchema", "classes"]
  gradle-args = ${common} ${off} ["-PprofilerScenario=java-gradle-schema-off"]
}

