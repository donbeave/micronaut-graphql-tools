<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.micronaut.platform</groupId>
    <artifactId>micronaut-parent</artifactId>
    <!-- the test replaces the tokens with the versions of the build -->
    <version>@micronaut.platform@</version>
  </parent>

  <groupId>example</groupId>
  <artifactId>maven-plugin-kotlin</artifactId>
  <version>0.1</version>

  <properties>
    <jdk.version>21</jdk.version>
    <release.version>21</release.version>
    <kotlin.version>@kotlin@</kotlin.version>
    <micronaut.graphql.tools.version>1.0.0-SNAPSHOT</micronaut.graphql.tools.version>
  </properties>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </pluginRepository>
    <pluginRepository>
      <!-- the library under test: the test passes its location -->
      <id>graphql-tools</id>
      <url>${graphql.tools.repository}</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
    <plugins>
      <plugin>
        <!-- stands in for the generator, which emits no file yet: puts a source file of kotlin into the generated directory before the goal runs -->
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>place-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/generated-sources/graphql-tools/kotlin</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/placed/kotlin</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- tag::plugin[] -->
      <plugin>
        <groupId>io.micronaut.graphql.tools</groupId>
        <artifactId>micronaut-graphql-tools-maven-plugin</artifactId>
        <version>${micronaut.graphql.tools.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <packageName>example.api</packageName>
          <language>KOTLIN</language>
        </configuration>
      </plugin>
      <!-- end::plugin[] -->
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>compile</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <!-- tag::kotlin-source-dirs[] -->
              <sourceDirs>
                <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                <sourceDir>${project.build.directory}/generated-sources/graphql-tools/kotlin</sourceDir>
              </sourceDirs>
              <!-- end::kotlin-source-dirs[] -->
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
