<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.micronaut.platform</groupId>
    <artifactId>micronaut-parent</artifactId>
    <!-- the test replaces the tokens with the versions of the build -->
    <version>@micronaut.platform@</version>
  </parent>

  <groupId>example</groupId>
  <artifactId>groovy-maven</artifactId>
  <version>0.1</version>

  <properties>
    <jdk.version>21</jdk.version>
    <release.version>21</release.version>
    <groovy.version>@groovy@</groovy.version>
    <micronaut.graphql.tools.version>1.0.0-SNAPSHOT</micronaut.graphql.tools.version>
    <!-- mvn verify -Dgraphql.checks=false compiles without the checks -->
    <graphql.checks>true</graphql.checks>
    <!-- mvn verify -Dgraphql.client.checks=false parses the client operations without validating them -->
    <graphql.client.checks>true</graphql.client.checks>
  </properties>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <!-- the library under test: the test passes its location -->
      <id>graphql-tools</id>
      <url>${graphql.tools.repository}</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <!-- tag::bom[] -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.micronaut.graphql.tools</groupId>
        <artifactId>micronaut-graphql-tools-bom</artifactId>
        <version>${micronaut.graphql.tools.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <!-- end::bom[] -->

  <dependencies>
    <dependency>
      <groupId>io.micronaut.graphql.tools</groupId>
      <artifactId>micronaut-graphql-tools</artifactId>
    </dependency>
    <!-- tag::client-dependency[] -->
    <dependency>
      <groupId>io.micronaut.graphql.tools</groupId>
      <artifactId>micronaut-graphql-tools-client</artifactId>
    </dependency>
    <!-- end::client-dependency[] -->
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy</artifactId>
    </dependency>
    <!-- tag::processor[] -->
    <dependency>
      <!-- the Groovy compiler loads the visitors from the compile classpath -->
      <groupId>io.micronaut.graphql.tools</groupId>
      <artifactId>micronaut-graphql-tools-processor</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- end::processor[] -->
    <dependency>
      <groupId>io.micronaut</groupId>
      <artifactId>micronaut-inject-groovy</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- tag::schema-dirs[] -->
      <plugin>
        <!-- the Groovy compiler reads its options from system properties of the Maven JVM -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>properties-maven-plugin</artifactId>
        <version>1.4.0</version>
        <executions>
          <execution>
            <phase>initialize</phase>
            <goals>
              <goal>set-system-properties</goal>
            </goals>
            <configuration>
              <properties>
                <property>
                  <name>micronaut.graphql.tools.processor.schema.dirs</name>
                  <value>${project.basedir}/src/main/resources/graphql</value>
                </property>
                <!-- tag::client-dirs[] -->
                <property>
                  <name>micronaut.graphql.tools.processor.client.dirs</name>
                  <value>${project.basedir}/src/main/graphql/client</value>
                </property>
                <!-- end::client-dirs[] -->
                <!-- tag::client-checks[] -->
                <property>
                  <name>micronaut.graphql.tools.processor.client.checks</name>
                  <value>${graphql.client.checks}</value>
                </property>
                <!-- end::client-checks[] -->
                <!-- tag::checks[] -->
                <property>
                  <name>micronaut.graphql.tools.processor.checks</name>
                  <value>${graphql.checks}</value>
                </property>
                <!-- end::checks[] -->
              </properties>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- end::schema-dirs[] -->
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
