scalar DateTime

scalar Unused

interface Node {
  id: ID!
}

type Folder implements Node {
  id: ID!
  name: String!
  size: Int!
  createdAt: DateTime!
  children: [Node!]!
}

type File implements Node {
  id: ID!
  name: String!
  bytes: Int!
  owner: User
}

type User implements Node {
  id: ID!
  name: String!
  tags: [String!]!
  role: Role!
  posts(first: Int = 10): [Post!]!
}

type Post {
  id: ID!
  title: String!
  body: String
  likes: Int!
  author: User!
}

union SearchResult = Folder | File | User

enum Role {
  ADMIN
  MEMBER
}

input PostFilter {
  text: String
  minLikes: Int! = 0
  role: Role
  since: DateTime
  tags: [String!]
}

type Query {
  node(id: ID!): Node
  search(text: String!, filter: PostFilter): [SearchResult!]!
  user(id: ID!): User
  posts(filter: PostFilter): [Post!]!
  viewer: User!
}

type Mutation {
  createPost(title: String!, body: String): Post!
}

type Subscription {
  postAdded: Post!
}

"The state of a book."
enum Status {
  "On the shelf."
  OPEN
  CLOSED @deprecated(reason: "Use OPEN.")
}

"A book of the library."
type Book implements Node {
  id: ID!
  "The title of the book."
  title: String!
  oldTitle: String @deprecated(reason: "Use title.")
  subtitle: String
  pages: Int
  rating: Float!
  inStock: Boolean!
  tags: [String]!
  editions: [Edition!]
  status: Status!
  author: User
}

type Edition {
  year: Int!
  label: String
  isbns: [[String!]!]
}

type Shelf {
  name: String!
  books: [Book!]!
  rows: [[Book]]
}

"What the library needs to add a book."
input BookInput {
  "The title of the book."
  title: String!
  subtitle: String
  pages: Int! = 100
  tags: [String!]! = []
  status: Status = OPEN
  nested: BookInput
}

extend type Query {
  bookCount: Int!
  titles: [String!]!
  matrix: [[Int!]!]!
  updated: DateTime
  topStatus: Status!
  book(id: ID!): Book
  shelf(name: String!): Shelf
  books(status: Status, first: Int! = 10): [Book!]!
}

extend type Mutation {
  addBook(input: BookInput!, dryRun: Boolean = false): Book!
}
